{
	"name": "ShanikJewls Store",
	"build": {
		"dockerfile": "Dockerfile"
	},

	"runArgs": [
    	"--hostname",
    	"ShanikJewls"
    ],
	
	"features": {
		"ghcr.io/anthropics/devcontainer-features/claude-code:latest": {}
	},

	// Install dependencies and start the server after	
	"postCreateCommand": "curl -fsSL https://claude.ai/claude-code/install.sh | sh && npm install",
	"postAttachCommand": "npm run start",
	
	"forwardPorts": [5000],
	"portsAttributes": {
		"5000": {
			"label": "Development Server",
			"onAutoForward": "openPreview"
		}
	},

	"customizations": {
    	"vscode": {
      		"settings": {
        		"workbench.editor.openPositioning": "right"
         	}
		}
	}
}