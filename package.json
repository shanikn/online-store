  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@jest/globals": "^29.7.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.15.0",
