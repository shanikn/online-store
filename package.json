{
  "name": "golden-jewelry-store",
  "version": "1.0.0",
  "description": "Online gold jewelry store - a Node.js Express app for FullStack course final project",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test.js",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration --coverage",
    "test:e2e": "jest tests/e2e --coverage",
    "test:jest": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=html --coverageReporters=text",
    "test:all": "npm run test:jest && npm run test",
    "test:ci": "jest --coverage --watchAll=false --passWithNoTests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "ecommerce",
    "jewelry",
    "online-store",
    "nodejs",
    "express",
    "fullstack"
  ],
  "author": "Shani Knobel",
  "license": "MIT",
  "homepage": "http://127.0.0.1:5000/store.html",
  "type": "commonjs",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.1.2",
    "eslint": "^9.36.0",
    "jest": "^30.1.3",
    "jest-html-reporters": "^3.1.7",
    "nyc": "^17.1.0",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
